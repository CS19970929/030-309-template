{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
        {
            "name": "firmware-debug",
            "displayName": "Firmware Debug",
            "description": "Reserved Debug preset for future firmware/CMakeLists.txt",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/artifacts/cmake/firmware-debug",
            "cacheVariables": {
                "BUILD_FIRMWARE": "ON",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchains/arm-none-eabi-gcc.cmake",
                "APP_RUNTIME_MONITOR": "ON",
                "APP_ENABLE_LTO": "OFF",
                "APP_OPT_LEVEL": "g"
            }
        },
    {
            "name": "firmware-release",
            "displayName": "Firmware Board Safe",
            "description": "Board-safe GCC build aligned closer to Keil behavior",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/artifacts/cmake/firmware-release",
            "cacheVariables": {
                "BUILD_FIRMWARE": "ON",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchains/arm-none-eabi-gcc.cmake",
                "APP_RUNTIME_MONITOR": "OFF",
                "APP_ENABLE_LTO": "OFF",
                "APP_OPT_LEVEL": "1"
            }
        },
        {
            "name": "firmware-optimized",
            "displayName": "Firmware Optimized",
            "description": "Size-optimized GCC build with runtime monitor and LTO enabled",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/artifacts/cmake/firmware-optimized",
            "cacheVariables": {
                "BUILD_FIRMWARE": "ON",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchains/arm-none-eabi-gcc.cmake",
                "APP_RUNTIME_MONITOR": "ON",
                "APP_ENABLE_LTO": "ON",
                "APP_OPT_LEVEL": "s"
            }
        },
        {
            "name": "firmware-monitor",
            "displayName": "Firmware Monitor",
            "description": "Board monitor build with runtime snapshot enabled and no LTO",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/artifacts/cmake/firmware-monitor",
            "cacheVariables": {
                "BUILD_FIRMWARE": "ON",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchains/arm-none-eabi-gcc.cmake",
                "APP_RUNTIME_MONITOR": "ON",
                "APP_ENABLE_LTO": "OFF",
                "APP_OPT_LEVEL": "1"
            }
        },
        {
            "name": "host-sim-debug",
            "displayName": "Host Simulation Debug",
            "description": "Native host-side simulation preset",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/artifacts/cmake/host-sim-debug",
            "cacheVariables": {
                "BUILD_HOST_SIM": "ON",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
    {
      "name": "build-firmware-debug",
      "configurePreset": "firmware-debug"
    },
        {
            "name": "build-firmware-release",
            "configurePreset": "firmware-release"
        },
        {
            "name": "build-firmware-optimized",
            "configurePreset": "firmware-optimized"
        },
        {
            "name": "build-firmware-monitor",
            "configurePreset": "firmware-monitor"
        },
        {
            "name": "build-host-sim-debug",
            "configurePreset": "host-sim-debug"
        }
    ]
}
